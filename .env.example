# ==============================================================================
# VectorCore Environment Configuration
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins allowed to call the API (same-origin needs no entry)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional Generative LLM Keys (Extractive synthesizer fallback is used if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Embedding & Reranker Device (cpu / cuda)
DEVICE=cpu
